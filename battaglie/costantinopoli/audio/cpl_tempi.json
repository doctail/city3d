   "text": "the Theodosian Walls:",
   "start": 12.519,
   "end": 13.938
  },
  {
   "text": "a moat,",
   "start": 13.938,
   "end": 14.561
  },
  {
   "text": "an outer wall,",
   "start": 14.561,
   "end": 15.465
  },
  {
   "text": "and an inner",
   "start": 15.465,
   "end": 16.172
  },
  {
   "text": "wall twelve",
   "start": 16.172,
   "end": 16.791
  },
  {
   "text": "meters high,",
   "start": 16.791,
   "end": 17.669
  },
  {
   "text": "with ninety-six towers.",
   "start": 17.669,
   "end": 19.356
  },
  {
   "text": "Sultan Mehmed the",
   "start": 19.377,
   "end": 20.329
  },
  {
   "text": "Second came with",
   "start": 20.329,
   "end": 21.236
  },
  {
   "text": "around eighty",
   "start": 21.236,
   "end": 21.962
  },
  {
   "text": "thousand men.",
   "start": 21.962,
   "end": 22.992
  },
  {
   "text": "Emperor Constantine the",
   "start": 23.012,
   "end": 24.295
  },
  {
   "text": "Eleventh had about",
   "start": 24.295,
   "end": 25.341
  },
  {
   "text": "seven thousand.",
   "start": 25.341,
   "end": 26.499
  },
  {
   "text": "But Mehmed had",
   "start": 26.52,
   "end": 27.36
  },
  {
   "text": "Orban's cannon.",
   "start": 27.36,
   "end": 28.457
  },
  {
   "text": "Its stone balls",
   "start": 28.477,
   "end": 29.346
  },
  {
   "text": "weighed half",
   "start": 29.346,
   "end": 30.031
  },
  {
   "text": "a ton.",
   "start": 30.031,
   "end": 30.747
  },
  {
   "text": "It fired only",
   "start": 30.768,
   "end": 31.556
  },
  {
   "text": "a few times",
   "start": 31.556,
   "end": 32.251
  },
  {
   "text": "a day",
   "start": 32.251,
   "end": 32.882
  },
  {
   "text": "and every hit",
   "start": 32.882,
   "end": 33.738
  },
  {
   "text": "tore the",
   "start": 33.738,
   "end": 34.292
  },
  {
   "text": "wall open.",
   "start": 34.292,
   "end": 35.246
  },
  {
   "text": "Each night,",
   "start": 35.267,
   "end": 36.03
  },
  {
   "text": "the defenders rebuilt",
   "start": 36.03,
   "end": 37.049
  },
  {
   "text": "the breach.",
   "start": 37.049,
   "end": 37.929
  },
  {
   "text": "The harbor was",
   "start": 37.949,
   "end": 38.77
  },
  {
   "text": "sealed by a",
   "start": 38.77,
   "end": 39.455
  },
  {
   "text": "giant chain.",
   "start": 39.455,
   "end": 40.444
  },
  {
   "text": "So Mehmed did",
   "start": 40.464,
   "end": 41.363
  },
  {
   "text": "the impossible.",
   "start": 41.363,
   "end": 42.611
  },
  {
   "text": "He dragged seventy",
   "start": 42.631,
   "end": 43.611
  },
  {
   "text": "ships over",
   "start": 43.611,
   "end": 44.19
  },
  {
   "text": "a hill,",
   "start": 44.19,
   "end": 44.85
  },
  {
   "text": "on greased logs,",
   "start": 44.85,
   "end": 46.271
  },
  {
   "text": "into the",
   "start": 46.271,
   "end": 46.758
  },
  {
   "text": "Golden Horn.",
   "start": 46.758,
   "end": 47.728
  },
  {
   "text": "Now the city",
   "start": 47.749,
   "end": 48.596
  },
  {
   "text": "was under attack",
   "start": 48.596,
   "end": 49.654
  },
  {
   "text": "from every side.",
   "start": 49.654,
   "end": 51.01
  },
  {
   "text": "On May twenty-ninth,",
   "start": 51.031,
   "end": 52.278
  },
  {
   "text": "after fifty-three days,",
   "start": 52.278,
   "end": 53.842
  },
  {
   "text": "the wall",
   "start": 53.842,
   "end": 54.329
  },
  {
   "text": "finally broke.",
   "start": 54.329,
   "end": 55.387
  },
  {
   "text": "Constantine was last",
   "start": 55.407,
   "end": 56.411
  },
  {
   "text": "seen fighting in",
   "start": 56.411,
   "end": 57.247
  },
  {
   "text": "the breach.",
   "start": 57.247,
   "end": 58.141
  },
  {
   "text": "An empire that",
   "start": 58.161,
   "end": 58.977
  },
  {
   "text": "had lasted a",
   "start": 58.977,
   "end": 59.703
  },
  {
   "text": "thousand years fell",
   "start": 59.703,
   "end": 60.747
  },
  {
   "text": "to a cannon",
   "start": 60.747,
   "end": 61.686
  },
  {
   "text": "and a fleet",
   "start": 61.686,
   "end": 62.361
  },
  {
   "text": "that crossed",
   "start": 62.361,
   "end": 63.036
  },
  {
   "text": "a hill.",
   "start": 63.036,
   "end": 64.241
  }
 ]
}