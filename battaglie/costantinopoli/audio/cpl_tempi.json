{
 "phrases": [
  {
   "start": 0.0,
   "end": 1.184,
   "text": "For a thousand years,"
  },
  {
   "start": 1.443,
   "end": 3.157,
   "text": "no army broke these walls."
  },
  {
   "start": 3.528,
   "end": 7.252,
   "text": "Then a twenty-one-year-old sultan brought a cannon nine meters long."
  },
  {
   "start": 7.622,
   "end": 8.431,
   "text": "Constantinople,"
  },
  {
   "start": 8.69,
   "end": 9.615,
   "text": "1453."
  },
  {
   "start": 9.985,
   "end": 11.318,
   "text": "Water on three sides."
  },
  {
   "start": 11.688,
   "end": 12.259,
   "text": "On the fourth,"
  },
  {
   "start": 12.519,
   "end": 13.678,
   "text": "the Theodosian Walls:"
  },
  {
   "start": 13.938,
   "end": 14.301,
   "text": "a moat,"
  },
  {
   "start": 14.561,
   "end": 15.205,
   "text": "an outer wall,"
  },
  {
   "start": 15.465,
   "end": 17.41,
   "text": "and an inner wall twelve meters high,"
  },
  {
   "start": 17.669,
   "end": 19.006,
   "text": "with ninety-six towers."
  },
  {
   "start": 19.377,
   "end": 22.642,
   "text": "Sultan Mehmed the Second came with around eighty thousand men."
  },
  {
   "start": 23.012,
   "end": 26.149,
   "text": "Emperor Constantine the Eleventh had about seven thousand."
  },
  {
   "start": 26.52,
   "end": 28.107,
   "text": "But Mehmed had Orban's cannon."
  },
  {
   "start": 28.477,
   "end": 30.397,
   "text": "Its stone balls weighed half a ton."
  },
  {
   "start": 30.768,
   "end": 32.622,
   "text": "It fired only a few times a day"
  },
  {
   "start": 32.882,
   "end": 34.896,
   "text": "and every hit tore the wall open."
  },
  {
   "start": 35.267,
   "end": 35.771,
   "text": "Each night,"
  },
  {
   "start": 36.03,
   "end": 37.579,
   "text": "the defenders rebuilt the breach."
  },
  {
   "start": 37.949,
   "end": 40.094,
   "text": "The harbor was sealed by a giant chain."
  },
  {
   "start": 40.464,
   "end": 42.261,
   "text": "So Mehmed did the impossible."
  },
  {
   "start": 42.631,
   "end": 44.591,
   "text": "He dragged seventy ships over a hill,"
  },
  {
   "start": 44.85,
   "end": 46.012,
   "text": "on greased logs,"
  },
  {
   "start": 46.271,
   "end": 47.378,
   "text": "into the Golden Horn."
  },
  {
   "start": 47.749,
   "end": 50.66,
   "text": "Now the city was under attack from every side."
  },
  {
   "start": 51.031,
   "end": 52.02,
   "text": "On May twenty-ninth,"
  },
  {
   "start": 52.278,
   "end": 53.582,
   "text": "after fifty-three days,"
  },
  {
   "start": 53.842,
   "end": 55.037,
   "text": "the wall finally broke."
  },
  {
   "start": 55.407,
   "end": 57.791,
   "text": "Constantine was last seen fighting in the breach."
  },
  {
   "start": 58.161,
   "end": 61.427,
   "text": "An empire that had lasted a thousand years fell to a cannon"
  },
  {
   "start": 61.686,
   "end": 63.441,
   "text": "and a fleet that crossed a hill."
  }
 ],
