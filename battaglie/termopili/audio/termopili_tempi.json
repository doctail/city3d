 "duration_video": 62.68,
 "scenes": [
  {
   "scene": 1,
   "start": 0.0,
   "end": 5.66,
   "vo": "Seven thousand Greeks. Over a hundred thousand Persians. And for three days, the Greeks didn't break."
  },
  {
   "scene": 2,
   "start": 5.66,
   "end": 14.67,
   "vo": "August, 480 BC. Xerxes invades Greece with the largest army the world had ever seen. To reach Athens, he has to go through here."
  },
  {
   "scene": 3,
   "start": 14.67,
   "end": 22.1,
   "vo": "Thermopylae. The Hot Gates. Mountain on one side, sea on the other. In places, the road was barely a cart wide."
  },
  {
   "scene": 4,
   "start": 22.1,
   "end": 26.9,
   "vo": "King Leonidas of Sparta rebuilt an old wall across the gap and waited."
  },
  {
   "scene": 5,
   "start": 26.9,
   "end": 36.78,
   "vo": "Xerxes sent wave after wave. In the narrow pass, his numbers meant nothing. Even his elite Immortals were thrown back. For two days, the wall held."
  },
  {
   "scene": 6,
   "start": 36.78,
   "end": 42.89,
   "vo": "Then a local man, Ephialtes, went to Xerxes for a reward. He knew a goat path over the mountain."
  },
  {
   "scene": 7,
   "start": 42.89,
   "end": 47.35,
   "vo": "That night, the Immortals climbed it. By dawn, they were behind the Greeks."
  },
  {
   "scene": 8,
   "start": 47.35,
   "end": 54.33,
   "vo": "Leonidas sent most of the army home. He stayed, with three hundred Spartans and about a thousand allies."
  },
  {
   "scene": 9,
   "start": 54.33,
   "end": 56.96,
   "vo": "They fought to the last man on this hill."
  },
  {
   "scene": 10,
   "start": 56.96,
   "end": 62.68,
   "vo": "Xerxes won the pass. Within a year, he had lost the war."
  }
 ],
